PORT=3000

# Conexión a la BD
# Formato: mysql://usuario:password@host:puerto/nombre_base_datos
DATABASE_URL="mysql://root:@localhost:3306/big_data_db"

# Correo para mandar el OTP (Resend)
# Obtén tu API key en https://resend.com/api-keys
RESEND_API_KEY=re_tu_api_key_aqui

# JWT
# Genera uno propio con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=reemplaza_esto_con_tu_propio_secreto_generado
JWT_EXPIRES_IN=1h

# Cloudinary (almacenamiento de archivos CSV)
CLOUDINARY_CLOUD_NAME=tu_cloud_name_aqui
CLOUDINARY_API_KEY=tu_api_key_aqui
CLOUDINARY_API_SECRET=tu_api_secret_aqui

# URL base del backend, usada para armar links en correos (ej. aceptar/rechazar acceso)
# En local: http://localhost:3000
# En producción (Railway): la URL pública del backend desplegado
BACKEND_URL=http://localhost:3000